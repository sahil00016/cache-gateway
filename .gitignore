# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Env
.env
.env.local

# Editors
.vscode/
.idea/

# Build / local artefacts
dist/
build/
# Benchmark results are deliberately NOT ignored. benchmarks/README.md states
# that raw JSON output is committed, and a reported number whose raw output
# cannot be inspected is not reproducible -- which is the whole argument the
# benchmark docs rest on. Smoke and scratch runs are the exception.
benchmarks/results/smoke-*.json
benchmarks/results/*-runsmoke.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
# tfvars holds the operator's IP and email. This repository is public, so the
# real file stays local and terraform.tfvars.example documents its shape.
*.tfvars
!*.tfvars.example

# Node (dashboard)
web/node_modules/
web/dist/
web/*.tsbuildinfo
