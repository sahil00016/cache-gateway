{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "description": "Reachability of a single dependency.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure reason, if unhealthy.",
            "title": "Error"
          },
          "healthy": {
            "description": "Whether the dependency answered.",
            "title": "Healthy",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Round-trip time of the probe query.",
            "title": "Latency Ms"
          },
          "name": {
            "description": "Dependency identifier, e.g. 'postgres'.",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResult": {
        "description": "Result of a liveness probe.",
        "properties": {
          "service": {
            "description": "Service name, for probe-side assertions.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "Always 'ok' when the process is running.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "LivenessResult",
        "type": "object"
      },
      "PageMeta": {
        "description": "Pagination metadata for a list response.",
        "properties": {
          "limit": {
            "description": "Page size requested.",
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Items skipped before this page.",
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Total items matching the query.",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "limit",
          "offset"
        ],
        "title": "PageMeta",
        "type": "object"
      },
      "PaginatedResponse_ProductRead_": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProductRead"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "success": {
            "default": true,
            "description": "Always true.",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "PaginatedResponse[ProductRead]",
        "type": "object"
      },
      "ProductRead": {
        "description": "A product as returned by the API.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_cents": {
            "description": "Price in minor units, to avoid float money.",
            "title": "Price Cents",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "description",
          "price_cents",
          "category",
          "created_at",
          "updated_at"
        ],
        "title": "ProductRead",
        "type": "object"
      },
      "ReadinessResult": {
        "description": "Result of a readiness probe across every dependency.",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "ready": {
            "description": "True only when every dependency is healthy.",
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "dependencies"
        ],
        "title": "ReadinessResult",
        "type": "object"
      },
      "SuccessResponse_ProductRead_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProductRead"
          },
          "success": {
            "default": true,
            "description": "Always true.",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessResponse[ProductRead]",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Sahil Sonker",
      "url": "https://github.com/sahil00016"
    },
    "description": "\nA read-through cache service in front of PostgreSQL.\n\nThis service exists to demonstrate the four ways a cache fails in production,\nand the fix for each:\n\n1. **Penetration** -- lookups for keys that do not exist bypass the cache\n   entirely and reach the database. Fixed with a Bloom filter.\n2. **Avalanche** -- many keys share a TTL and expire together. Fixed with\n   TTL jitter.\n3. **Stampede** -- one hot key expires and every concurrent request misses.\n   Fixed with in-process request coalescing, and optionally a Redis lock\n   across workers.\n4. **Consistency** -- a write updates the database but not the cache. Fixed\n   with cache-aside invalidation.\n\nEvery protection is independently toggleable, so each failure can be\nreproduced on a running instance.\n",
    "title": "Cache Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Report that the process is alive.\n\nDeliberately touches no dependency.\n\nReturns:\n    A static liveness result.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Report whether every dependency is reachable.\n\nArgs:\n    response: Injected so the status code can be set to 503 when not ready.\n\nReturns:\n    The readiness result, listing every dependency.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/products": {
      "get": {
        "description": "Return several products in one request.\n\nExists mainly to expose stampede behaviour more sharply than the single\nread can: one request can miss on many keys at once.\n\nArgs:\n    service: Injected product service.\n    ids: Product ids to fetch, capped to keep one request from becoming a\n        denial-of-service vector against the database.\n\nReturns:\n    The products that were found. Missing ids are omitted, not errors.",
        "operationId": "get_products_v1_products_get",
        "parameters": [
          {
            "description": "Product ids. Repeat the parameter: ?ids=1&ids=2",
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "description": "Product ids. Repeat the parameter: ?ids=1&ids=2",
              "items": {
                "type": "integer"
              },
              "maxItems": 100,
              "minItems": 1,
              "title": "Ids",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_ProductRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fetch several products by id",
        "tags": [
          "products"
        ]
      }
    },
    "/v1/products/{product_id}": {
      "get": {
        "description": "Return a single product.\n\nArgs:\n    product_id: The product's id.\n    service: Injected product service.\n\nReturns:\n    The product, wrapped in the standard success envelope.",
        "operationId": "get_product_v1_products__product_id__get",
        "parameters": [
          {
            "description": "Product id.",
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "description": "Product id.",
              "minimum": 1,
              "title": "Product Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ProductRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fetch one product by id",
        "tags": [
          "products"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness, readiness and metrics.",
      "name": "health"
    }
  ]
}
