# Copy to .env for local development. Never commit .env.
# Every value here is validated at boot; a bad value stops the process.

# --- app ---
APP_NAME=cache-gateway
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=true

# --- datastores ---
DATABASE_URL=postgresql+asyncpg://cache_gateway:cache_gateway@localhost:5433/cache_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
# Log every SQL statement. On in local because this project is about DB load.
DB_ECHO=true

REDIS_URL=redis://localhost:6380/0
REDIS_MAX_CONNECTIONS=50

# --- cache ---
CACHE_TTL_SECONDS=300
# Avalanche protection. Set to 0 to reproduce failure mode 2.
CACHE_TTL_JITTER_PCT=10
CACHE_KEY_PREFIX=product:v1
# cache_aside | write_through
WRITE_STRATEGY=cache_aside

# --- failure-mode protections (each toggles one fix off, for demos) ---
BLOOM_ENABLED=true
BLOOM_EXPECTED_ITEMS=1000000
BLOOM_FP_RATE=0.01

COALESCE_ENABLED=true
REDIS_LOCK_ENABLED=false
REDIS_LOCK_TTL_MS=5000

# --- runtime ---
# Not just a deploy knob: the Bloom filter and the coalescer are per-process,
# so this number changes what those protections can guarantee.
WEB_CONCURRENCY=4

# --- observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cache-gateway
METRICS_ENABLED=true
